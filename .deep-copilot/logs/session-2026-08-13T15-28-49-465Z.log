[2026-08-13T21:55:28.742Z] [TOOL_CALL] {"id":"call_00_BfUJkY8xT1k2CaOIUdfb9657","name":"write_file","args":{"path":"bounce_atr_opt.py","content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nПодбор множителей ATR и метода уровней для стратегии отскока (bounce).\n\nЛогика:\n  - уровни (Pivot / Camarilla / DeMark) считаются из предыдущего дня;\n  - лимитные ордера ставятся ПЕРЕД уровнем:\n      Buy  Limit = S + buffer_atr_s * ATR   (лонг, отскок от поддержки)\n      Sell Limit = R - buffer_atr_r * ATR   (шорт, отскок от сопротивления)\n  - SL       = sl_atr       * ATR от цены входа;\n  - трейлинг = trailing_atr * ATR (стоп двигается за ценой в next()).\n\nОптимизация в два прохода (полная сетка из 7 параметров слишком велика):\n  pass 1: только ЛОНГ -> level_method, buffer_atr_s, sl_atr_s, trailing_atr_s\n  pass 2: только ШОРТ -> level_method, buffer_atr_r, sl_atr_r, trailing_atr_r\n  pass 3: выбор метода с зафиксированными лучшими S/R-множителями\nПроверка лучшей комбинации на тестовом периоде (2025).\n\nЗапуск:\n  python bounce_atr_opt.py            # полный подбор\n  python bounce_atr_opt.py --smoke    # быстрая проверка (2024 + H1 2025)\n\"\"\"\n\nimport sys\nfrom itertools import product\n\nimport numpy as np\nimport pandas as pd\n\nfrom backtesting import Backtest, Strategy\n\n# ================================================================\n#  КОНФИГУРАЦИЯ\n# ================================================================\nCONFIG = {\n    \"data_path\": \"data/EURUSD_H1_2020-01-01_2025-12-31.csv\",\n    \"atr_period\": 14,\n    # Сдвиг начала суток для расчёта дневных уровней.\n    # 0 = полночь UTC по времени баров. Если уровни в MT5 считаются\n    # по серверным суткам (обычно UTC+2/+3), задайте 2 или 3.\n    \"day_offset_hours\": 0,\n    \"split_date\": \"2025-01-01\",   # подбор до этой даты, проверка с неё\n    \"cash\": 10_000,\n    \"commission\": 0.0001,         # 0.01% — спред не моделируется\n    \"min_trades\": 30,             # минимум сделок для отсева дегенерата\n    \"top_n\": 10,                  # сколько комбинаций показывать в топе\n}\n\n# Сетки множителей (одинаковые для S и R)\nBUFFER_GRID = [0.25, 0.5, 0.75, 1.0]\nSL_GRID     = [1.0, 1.5, 2.0, 2.5, 3.0]\nTRAIL_GRID  = [1.0, 1.5, 2.0, 2.5]\n\nLEVEL_METHOD_NAMES = {0: \"Camarilla\", 1: \"Pivot (классика)\", 2: \"DeMark\"}\n\n# Поддержки/сопротивления по методам (колонки, создаваемые в prepare)\nSUP_COLS = {\n    0: [\"cam_s1\", \"cam_s2\", \"cam_s3\", \"cam_s4\"],\n    1: [\"piv_s1\", \"piv_s2\", \"piv_s3\"],\n    2: [\"dem_s1\"],\n}\nRES_COLS = {\n    0: [\"cam_r1\", \"cam_r2\", \"cam_r3\", \"cam_r4\"],\n    1: [\"piv_r1\", \"piv_r2\", \"piv_r3\"],\n    2: [\"dem_r1\"],\n}\n\n\n# ================================================================\n#  УРОВНИ\n# ================================================================\ndef camarilla_levels(d1: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Camarilla: R1-R4 / S1-S4, коэф. 1.1/12, /6, /4, /2.\"\"\"\n    h, l, c = d1[\"High\"], d1[\"Low\"], d1[\"Close\"]\n    hl = h - l\n    out = pd.DataFrame(index=d1.index)\n    for i, div in enumerate([12, 6, 4, 2], start=1):\n        out[f\"cam_r{i}\"] = c + hl * 1.1 / div\n        out[f\"cam_s{i}\"] = c - hl * 1.1 / div\n    return out\n\n\ndef pivot_levels(d1: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"Классические Pivot: P, R1-R3 / S1-S3.\"\"\"\n    h, l, c = d1[\"High\"], d1[\"Low\"], d1[\"Close\"]\n    p = (h + l + c) / 3\n    out = pd.DataFrame(index=d1.index)\n    out[\"piv_r1\"] = 2 * p - l\n    out[\"piv_s1\"] = 2 * p - h\n    out[\"piv_r2\"] = p + (h - l)\n    out[\"piv_s2\"] = p - (h - l)\n    out[\"piv_r3\"] = h + 2 * (p - l)\n    out[\"piv_s3\"] = l - 2 * (h - p)\n    return out\n\n\ndef demark_levels(d1: pd.DataFrame) -> pd.DataFrame:\n    \"\"\"DeMark: P, R1 / S1 (X зависит от close vs open).\"\"\"\n    h, l, c, o = d1[\"High\"], d1[\"Low\"], d1[\"Close\"], d1[\"Open\"]\n    x = pd.Series(\n        np.where(c < o, h + 2 * l + c,\n                 np.where(c > o, 2 * h + l + c, h + l + 2 * c)),\n        index=d1.index,\n    )\n    out = pd.DataFrame(index=d1.index)\n    out[\"dem_r1\"] = x / 2 - l\n    out[\"dem_s1\"] = x / 2 - h\n    return out\n\n\n# ================================================================\n#  ДАННЫЕ\n# ================================================================\ndef load_and_prepare…(+11654 chars)"}}
