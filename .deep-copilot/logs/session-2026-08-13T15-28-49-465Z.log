end_date\"]\r\n    output_name = cfg[\"output_name\"]\r\n    output_dir = cfg[\"output_dir\"]\r\n    fmt = cfg[\"format\"]\r\n\r\n    if not mt5.initialize():\r\n        print(f\"Ошибка инициализации MT5: {mt5.last_error()}\")\r\n        sys.exit(1)\r\n\r\n    try:\r\n        start_dt = datetime.strptime(start_date, \"%Y-%m-%d\")"}
