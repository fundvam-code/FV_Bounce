[2026-08-12T12:50:30.637Z] [TOOL_CALL] {"id":"call_00_UGjRBf2TF6jpeXcdbRdQ5120","name":"write_file","args":{"content":"\"\"\"diag_signals.py -- разовая диагностика: почему EA не открывает сделки.\n\nПрогоняет модель по всей истории EURUSD M15 и считает, сколько баров\nпроходят фильтры входа из TrendRNN_EA.mq5:\n  flat-фильтр:  probFlat <= InpMaxFlatProb\n  confidence:   probBuy/Sell > InpConfidence\n  gap:          |probBuy - probSell| >= InpMinSignalGap\n\nПоказывает распределение вероятностей и долю проходящих сигналов, чтобы\nпонять, какой фильтр душит входы (модель обучена с confidence_threshold=0.4,\nа в пресете стоит 0.6 + flat 0.6 + gap 0.1).\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nimport onnxruntime as ort\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\nfrom features import build_feature_matrix\n\nSEQ_LEN = 48\nCONFIDENCE = 0.60\nMAX_FLAT = 0.60\nMIN_GAP = 0.10\n\nMODEL = Path(\"models/trend_rnn.onnx\")\nMETA = Path(\"models/model_onnx_meta.json\")\nHISTORY = Path(\"data/raw/eurusd_m15_history.csv\")\n\n\ndef main() -> None:\n    df = pd.read_csv(HISTORY, parse_dates=[\"time\"]).set_index(\"time\")\n    feats, _ = build_feature_matrix(df)\n\n    # Warmup: ADX нужен ~2*14 баров; берём запас.\n    feats = feats.dropna()\n    print(f\"Баров после прогрева: {len(feats)}\")\n\n    sess = ort.InferenceSession(str(MODEL), providers=[\"CPUExecutionProvider\"])\n    input_name = sess.get_inputs()[0].name\n\n    prob_sell, prob_flat, prob_buy = [], [], []\n    n = len(feats)\n    for start in range(0, n - SEQ_LEN):\n        window = feats.iloc[start : start + SEQ_LEN].to_numpy(dtype=np.float32)\n        out = sess.run(None, {input_name: window[None, :, :]})[0][0]\n        prob_sell.append(out[0])\n        prob_flat.append(out[1])\n        prob_buy.append(out[2])\n\n    ps = np.array(prob_sell)\n    pf = np.array(prob_flat)\n    pb = np.array(prob_buy)\n\n    print(f\"\\n=== Распределение вероятностей по {len(ps)} барам ===\")\n    for name, arr in ((\"probBuy\", pb), (\"probFlat\", pf), (\"probSell\", ps)):\n        print(f\"{name:9s}: min={arr.min():.3f} p25={np.percentile(arr,25):.3f} \"\n              f\"median={np.median(arr):.3f} p75={np.percentile(arr,75):.3f} max={arr.max():.3f} \"\n              f\"| >0.5: {(arr>0.5).mean()*100:.1f}%  >0.6: {(arr>0.6).mean()*100:.1f}%  >0.7: {(arr>0.7).mean()*100:.1f}%\")\n\n    # Классический аргумент max (как в старой версии): какой класс доминирует\n    argmax = np.argmax(np.stack([ps, pf, pb], axis=1), axis=1)\n    names = {0: \"Sell\", 1: \"Flat\", 2: \"Buy\"}\n    vc = pd.Series(argmax).map(names).value_counts()\n    print(\"\\nДоминирующий класс (argmax):\")\n    for k, v in vc.items():\n        print(f\"  {k}: {v} ({v/len(argmax)*100:.1f}%)\")\n\n    # Фильтры по очереди\n    print(f\"\\n=== Прохождение фильтров (Conf={CONFIDENCE}, MaxFlat={MAX_FLAT}, Gap={MIN_GAP}) ===\")\n    flat_ok = pf <= MAX_FLAT\n    print(f\"flat-фильтр probFlat<={MAX_FLAT}:            {flat_ok.mean()*100:.1f}% баров\")\n\n    buy_ok = (pb > CONFIDENCE) & (pb - ps >= MIN_GAP)\n    sell_ok = (ps > CONFIDENCE) & (ps - pb >= MIN_GAP)\n    print(f\"confidence+gap BUY  (pb>{CONFIDENCE}, pb-ps>={MIN_GAP}): {buy_ok.mean()*100:.1f}% баров\")\n    print(f\"confidence+gap SELL (ps>{CONFIDENCE}, ps-pb>={MIN_GAP}): {sell_ok.mean()*100:.1f}% баров\")\n\n    buy_signal = buy_ok & flat_ok\n    sell_signal = sell_ok & flat_ok\n    print(f\"\\nИТОГО сигналов BUY  (все фильтры): {int(buy_signal.sum())} ({buy_signal.mean()*100:.2f}% баров)\")\n    print(f\"ИТОГО сигналов SELL (все фильтры): {int(sell_signal.sum())} ({sell_signal.mean()*100:.2f}% баров)\")\n    print(f\"ИТОГО ВСЕХ сигналов:                {int((buy_signal|sell_signal).sum())}\")\n\n    # Для сравнения: сколько сигналов при порогах из meta.json (0.4) и без gap\n    for conf, flat, gap in ((0.4, 0.6, 0.0), (0.5, 0.6, 0.1), (0.6, 0.7, 0.1), (0.6, 0.8, 0.0)):\n        b = (pb > conf) & (pb - ps >= gap) & (pf <= flat)\n        s = (ps > conf) & (ps - pb >= gap) & (pf <= flat)\n        print(f\"  Conf={conf} MaxFlat={flat} Gap={gap}: BUY={int(b.sum())} SELL={int(s.sum())}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","path":"src/diag_signals.py"}}
