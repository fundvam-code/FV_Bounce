input double InpConfidence           = 0.60;  // порог вероятности класса для входа\ninput double InpMaxFlatProb          = 0.60;  // не входить если probFlat выше этого порога\ninput double InpMinSignalGap         = 0.10;  // мин. зазор между Buy/Sell вероятностями для входа\nenum ENUM_SIGNAL_MODE\n  {\n   CLEAN = 0,      // сигнал прошёл фильтры -> вход сразу\n   AFTER_FLAT = 1, // вход только если предыдущий бар был флэтовым (не дал сигнала)\n   WAIT_TWO = 2    // первый сигнал после флэта запоминаем, вход только если след. бар подтверждает\n  };\ninput ENUM_SIGNAL_MODE InpSignalMode = CLEAN;\n\ninput group \"Риск-менеджмент\"\ninput double InpSlPoints             = 300;   // фиксированный SL, пунктов\ninput double InpTpPoints             = 150;   // фиксированный TP, пунктов\ninput double InpBreakevenBufferPoints = 100;  // буфер безубытка: через сколько пунктов прибыли перенести SL в цену открытия (0 = выключен)\ninput double InpRiskPercent          = 1.0;   // % риска от equity на сделку\ninput double InpMaxSpreadPoints      = 20;    // фильтр спреда, пунктов\ninput int    InpSessionStartHour     = 7;     // серверное время; start==end -- фильтр выключен\ninput int    InpSessionEndHour       = 21;\ninput int    InpMaxTradesPerDay      = 5;\ninput int    InpMaxTradesPerWeek     = 15;\ninput double InpMaxDrawdownPct       = 20.0;  // автостоп торговли при просадке от пика equity\n\ninput group \"Прочее\"\ninput ulong  InpMagic                = 20260809;\n\nCTrade   trade;\nlong     g_onnxHandle  = INVALID_HANDLE;\ndatetime g_lastBarTime = 0;\n\n// Состояние логики входа между барами.\nbool g_prevBarWasFlat   = true;  // AFTER_FLAT: дал ли ПРЕДЫДУЩИЙ бар CLEAN-сигнал (старт: считаем флэтом)\nint  g_pendingSignal    = 0;     // WAIT_TWO: 0=none, 1=buy, -1=sell (первый сигнал после флэта)\nbool g_needFlat         = true;  // WAIT_TWO: true = нужен флэтовый бар перед приёмом нового pending (старт: ждём флэт)\n\nint OnInit()\n  {\n   if(_Symbol != \"EURUSD\" && Strin