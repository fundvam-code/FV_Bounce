[2026-08-12T12:24:16.563Z] [TOOL_RESULT] {"id":"call_00_nu3V90MFI5KnxHWFbZEq4099","name":"read_file","elapsed_ms":9,"ok":true,"output":"//+------------------------------------------------------------------+\n//| RiskManager.mqh                                                   |\n//| Размер позиции от % риска, фиксированные SL/TP/безубыток, лимиты   |\n//| сделок в день/неделю, автостоп по просадке, фильтры спреда/сессии.|\n//| Все пороги передаются извне (см. input-параметры                   |\n//| в TrendRNN_EA.mq5), чтобы Strategy Tester мог их оптимизировать.  |\n//+------------------------------------------------------------------+\n#ifndef RISK_MANAGER_MQH\n#define RISK_MANAGER_MQH\n\ndouble   g_equityPeak     = 0.0;\nbool     g_tradingPaused  = false;\ndatetime g_lastDayStart   = 0;\ndatetime g_lastWeekStart  = 0;\nint      g_tradesToday    = 0;\nint      g_tradesThisWeek = 0;\n\n// Лот от риска в % от equity и дистанции SL (в пунктах) -- через\n// tick value/tick size, а не наивное \"пункт = деньги\", чтобы корректно\n// работать для любой котируемой валюты счёта/символа.\ndouble CalcLotSize(const double riskPercent, const double slDistancePoints)\n  {\n   double equity = AccountInfoDouble(ACCOUNT_EQUITY);\n   double riskMoney = equity * riskPercent / 100.0;\n\n   double tickValue = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);\n   double tickSize  = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);\n   double point     = SymbolInfoDouble(_Symbol, SYMBOL_POINT);\n   if(tickValue <= 0.0 || tickSize <= 0.0 || point <= 0.0 || slDistancePoints <= 0.0)\n      return(0.0);\n\n   double slDistancePrice = slDistancePoints * point;\n   double valuePerLot = (slDistancePrice / tickSize) * tickValue;\n   if(valuePerLot <= 0.0) return(0.0);\n\n   double lots = riskMoney / valuePerLot;\n\n   double minLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);\n   double maxLot  = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);\n   double lotStep = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);\n   if(lotStep <= 0.0) lotStep = minLot;\n\n   lots = MathFloor(lots / lotStep) * lotStep;\n   lots = MathMax(minLot, MathMin(maxLot, lots));\n   return(lots);"}
