[2026-08-12T10:55:27.090Z] [TOOL_RESULT] {"id":"call_00_eHZCQuiFGaln8izQyvSp1009","name":"read_file","elapsed_ms":67,"ok":true,"output":"\"\"\"select_best.py — выбирает лучшую сеть среди Optuna-трайлов.\n\nЭтап 1: топ-N трайлов по val macro-F1 прогоняются через упрощённый\nфикс-правило бэктест (SL/TP = k*ATR, тот же k, что и в разметке; фикс.\nспред; один вход за раз), ранжируются по Profit Factor на val.\n\nЭтап 2: топ-M финалистов перепроверяются на held-out test (никогда не\nучаствовавшем в обучении/pruning), разбитом на несколько хронологических\nфолдов -- финальный выбор отдаёт предпочтение стабильности (худший фолд),\nа не только пиковому результату.\n\nВАЖНО: это быстрый инструмент ранжирования кандидатов, а не настоящий\nбэктест. Реальная оптимизация риск-менеджмента делается позже в MT5 Strategy\nTester на уже собранном EA и реальных тиковых данных брокера (Этап 7 плана).\n\nИспользование:\n  python src/select_best.py\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport optuna\nimport torch\n\nfrom model import load_checkpoint\n\nDEFAULT_TOP_N = 8\nDEFAULT_FINALISTS = 3\nDEFAULT_SPREAD = 0.00012\nDEFAULT_CONFIDENCE = 0.4\nMIN_TRADES_FOR_CONFIDENCE = 30\n\n\ndef simulate_fixed_rule(probs: np.ndarray, y_true: np.ndarray, atr: np.ndarray, k: float, spread: float, confidence: float) -> dict:\n    pred = probs.argmax(axis=1)\n    conf = probs.max(axis=1)\n    take_trade = (pred != 1) & (conf > confidence)  # class index 1 = Flat\n\n    pred_dir = np.where(pred == 2, 1, -1)  # 2=Buy -> +1, 0=Sell -> -1\n    true_dir = y_true  # already in {-1, 0, 1}\n\n    barrier = k * atr\n    pnl = np.zeros(len(y_true), dtype=np.float64)\n    correct = take_trade & (true_dir == pred_dir)\n    wrong = take_trade & (true_dir == -pred_dir)\n    scratch = take_trade & (true_dir == 0)\n\n    pnl[correct] = barrier[correct] - spread\n    pnl[wrong] = -barrier[wrong] - spread\n    pnl[scratch] = -spread\n\n    n_trades = int(take_trade.sum())\n    traded_pnl = pnl[take_trade]\n    wins = traded_pnl[traded_pnl > 0]\n    losses = traded_pnl[traded_pnl < 0]\n    gross_win = float(wins.sum())\n    "}
