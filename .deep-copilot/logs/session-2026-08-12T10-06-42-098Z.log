[2026-08-12T10:55:22.730Z] [TOOL_RESULT] {"id":"call_00_cS44bidE5as1ajPLFYhO8090","name":"read_file","elapsed_ms":213,"ok":true,"output":"\"\"\"Модель и контракт классов, общие для learn.py / select_best.py / export_onnx.py.\n\nCLASS_NAMES фиксирует порядок выходов сети: индекс 0=Sell, 1=Flat, 2=Buy.\nЭтот порядок должен быть задокументирован один в один в EA (см.\nmt5/Experts/TrendRNN_EA.mq5) -- перепутать индексы значит молча развернуть\nнаправление торговли.\n\"\"\"\nfrom __future__ import annotations\n\nimport numpy as np\nimport torch\nimport torch.nn as nn\n\nCLASS_NAMES = [\"sell\", \"flat\", \"buy\"]\nLABEL_TO_CLASS_IDX = {-1: 0, 0: 1, 1: 2}\nCLASS_IDX_TO_LABEL = {v: k for k, v in LABEL_TO_CLASS_IDX.items()}\n\n\ndef labels_to_class_idx(y_raw: np.ndarray) -> np.ndarray:\n    return np.select([y_raw == -1, y_raw == 0, y_raw == 1], [0, 1, 2]).astype(np.int64)\n\n\nclass FixedStandardizer(nn.Module):\n    \"\"\"(x - mean) / std with mean/std as buffers (not parameters), so PyTorch's\n    ONNX exporter bakes them in as fixed graph constants rather than trainable\n    weights -- the EA feeds raw (not pre-normalized) features and the graph\n    does the rest, so Python and MQL5 never need two copies of this math.\"\"\"\n\n    def __init__(self, mean: torch.Tensor, std: torch.Tensor, eps: float = 1e-6):\n        super().__init__()\n        self.register_buffer(\"mean\", mean.view(1, 1, -1).float())\n        self.register_buffer(\"std\", std.view(1, 1, -1).float().clamp_min(eps))\n\n    def forward(self, x: torch.Tensor) -> torch.Tensor:\n        return (x - self.mean) / self.std\n\n\nclass TrendRNN(nn.Module):\n    def __init__(\n        self,\n        n_features: int,\n        hidden_size: int,\n        num_layers: int,\n        cell_type: str,\n        dropout: float,\n        bidirectional: bool,\n        mean: torch.Tensor,\n        std: torch.Tensor,\n    ):\n        super().__init__()\n        self.standardizer = FixedStandardizer(mean, std)\n        rnn_cls = nn.LSTM if cell_type == \"LSTM\" else nn.GRU\n        self.rnn = rnn_cls(\n            input_size=n_features,\n            hidden_size=hidden_size,\n            num_layers=num_layers,\n            batch_first=True,\n "}
[2026-08-12T10:55:22.730Z] [TOOL_RESULT] {"id":"call_01_IMZryS6RXupUcEfGf7UN1339","name":"read_file","elapsed_ms":208,"ok":true,"output":"\"\"\"learn.py — перебор гиперпараметров RNN (Optuna) на dataset_clean.npz.\n\nResumable: study хранится в sqlite (--study-db), можно убить процесс (Ctrl+C\nили закрытие терминала) и перезапустить той же командой -- уже пройденные\nтрайлы не теряются, досчитываются только недостающие до --n-trials.\n\nПространство поиска -- в configs/search_space.yaml, редактируется без правки\nкода.\n\nИспользование:\n  python src/learn.py --dataset data/processed/dataset_clean.npz\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport gc\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport optuna\nimport torch\nimport torch.nn as nn\nimport yaml\nfrom optuna.pruners import MedianPruner\nfrom optuna.samplers import TPESampler\nfrom sklearn.metrics import f1_score\n\nfrom model import TrendRNN, labels_to_class_idx\n\nDEFAULT_N_TRIALS = 50\nDEFAULT_MAX_EPOCHS = 40\nDEFAULT_PATIENCE = 8\nDEFAULT_GRAD_CLIP = 1.0\n\n\ndef load_search_space(path: Path) -> tuple[dict, dict]:\n    with open(path, encoding=\"utf-8\") as f:\n        cfg = yaml.safe_load(f)\n    training = cfg.pop(\"training\", {})\n    return cfg, training\n\n\ndef suggest_from_space(trial: optuna.Trial, space: dict) -> dict:\n    params = {}\n    for name, spec in space.items():\n        t = spec[\"type\"]\n        if t == \"categorical\":\n            params[name] = trial.suggest_categorical(name, spec[\"choices\"])\n        elif t == \"int\":\n            params[name] = trial.suggest_int(name, spec[\"low\"], spec[\"high\"], step=spec.get(\"step\", 1))\n        elif t == \"float\":\n            params[name] = trial.suggest_float(name, spec[\"low\"], spec[\"high\"], log=spec.get(\"log\", False))\n        else:\n            raise ValueError(f\"неизвестный type={t!r} в search_space для {name!r}\")\n    return params\n\n\ndef compute_class_weights(y_idx: np.ndarray, n_classes: int = 3) -> torch.Tensor:\n    counts = np.maximum(np.bincount(y_idx, minlength=n_classes).astype(np.float64), 1.0)\n    weights = counts.sum() / (n_classes * counts)\n    return torch.tensor(weights, dty"}
[2026-08-12T10:55:22.730Z] [TOOL_RESULT] {"id":"call_02_B77k6yKnzCwzl3FhehXJ4063","name":"read_file","elapsed_ms":206,"ok":true,"output":"\"\"\"Единый контракт признаков между Python (обучение) и MQL5 (mt5/Include/FeatureCalc.mqh).\n\nПорядок FEATURE_COLUMNS фиксирован. Если он меняется -- нужно синхронно\nобновить FeatureCalc.mqh и переобучить/переэкспортировать модель, иначе\nEA будет скармливать сети признаки не в том порядке, в котором она обучалась.\n\nНесколько формул здесь намеренно повторяют MT5-специфичные детали\nвстроенных индикаторов (не \"учебниковые\" версии), чтобы 1-в-1 совпадать\nс тем, что реально считает iRSI/iMACD/iADX/iBands в MQL5:\n  - RSI и ADX используют сглаживание Уайлдера (alpha=1/period), как и ATR.\n  - Сигнальная линия MACD в MT5 -- SMA от MACD-линии, а не EMA (это\n    отличается от \"стандартного\" MACD на большинстве других платформ).\n  - Bollinger Bands в MT5 считает стандартное отклонение по популяции\n    (деление на N), а не по выборке (N-1, pandas default).\n\"\"\"\nfrom __future__ import annotations\n\nimport numpy as np\nimport pandas as pd\n\nATR_PERIOD = 14\nRSI_PERIOD = 14\nADX_PERIOD = 14\nMACD_FAST = 12\nMACD_SLOW = 26\nMACD_SIGNAL = 9\nBB_PERIOD = 20\nBB_NUM_STD = 2.0\nEMA_DIST_PERIOD = 20\nROC_SHORT = 4\nROC_LONG = 16\nVOLUME_MA_PERIOD = 20\nHTF_RULE = \"1h\"\nHTF_FAST_EMA = 20\nHTF_SLOW_EMA = 50\n\nFEATURE_COLUMNS = [\n    \"logret_open\",\n    \"logret_high\",\n    \"logret_low\",\n    \"logret_close\",\n    \"atr_pct\",\n    \"range_vs_atr\",\n    \"tod_sin\",\n    \"tod_cos\",\n    \"dow_sin\",\n    \"dow_cos\",\n    \"htf_ema_dist\",\n    \"rsi_norm\",\n    \"macd_norm\",\n    \"adx_norm\",\n    \"bb_pctb\",\n    \"ema_dist_norm\",\n    \"roc_short\",\n    \"roc_long\",\n    \"volume_ratio\",\n]\n\n\ndef _wilder_smooth(values: np.ndarray, period: int) -> np.ndarray:\n    \"\"\"Wilder smoothing (alpha=1/period, simple-mean seed) -- the recursive\n    smoothing shared by ATR, RSI and ADX in MT5's built-in indicators.\"\"\"\n    n = len(values)\n    out = np.full(n, np.nan, dtype=np.float64)\n    if n >= period:\n        out[period - 1] = values[:period].mean()\n        for t in range(period, n):\n            out[t] = (out[t - 1] * (period - 1) + values[t]) / period\n    r"}
[2026-08-12T10:55:22.731Z] [TOOL_RESULT] {"id":"call_03_PD55Jujana9VBQ1evqaR4001","name":"read_file","elapsed_ms":203,"ok":true,"output":"\"\"\"prepare_data.py — читает CSV с историей M15 (см. mt5/Scripts/ExportHistory.mq5),\nстроит признаки (features.py), размечает triple-barrier метками и нарезает\nокна для RNN.\n\nИспользование:\n  # 1) сначала подобрать k (ATR-множитель барьера) и horizon (вертикальный\n  #    барьер, баров) по балансу классов:\n  python src/prepare_data.py --raw-csv data/raw/eurusd_m15_history.csv --grid-search\n\n  # 2) затем сгенерировать полный датасет с выбранными k/horizon:\n  python src/prepare_data.py --raw-csv data/raw/eurusd_m15_history.csv --k 2.0 --horizon 24\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom numpy.lib.stride_tricks import sliding_window_view\n\nfrom features import FEATURE_COLUMNS, build_feature_matrix\n\nDEFAULT_MAX_SEQ_LEN = 128\nDEFAULT_K_GRID = [1.5, 2.0, 2.5, 3.0]\nDEFAULT_H_GRID = [16, 24, 32]\nDEFAULT_VAL_FRAC = 0.15\nDEFAULT_TEST_FRAC = 0.15\n\n\ndef load_raw_csv(path: Path) -> pd.DataFrame:\n    df = pd.read_csv(path)\n    df[\"time\"] = pd.to_datetime(df[\"time\"], format=\"%Y.%m.%d %H:%M:%S\")\n    df = df.sort_values(\"time\").drop_duplicates(\"time\", keep=\"first\").set_index(\"time\")\n    return df[[\"open\", \"high\", \"low\", \"close\", \"tick_volume\"]].astype(np.float64)\n\n\ndef triple_barrier_labels(\n    close: np.ndarray,\n    high: np.ndarray,\n    low: np.ndarray,\n    open_: np.ndarray,\n    atr: np.ndarray,\n    k: float,\n    horizon: int,\n) -> tuple[np.ndarray, np.ndarray, np.ndarray]:\n    \"\"\"label[t] in {+1 Buy, -1 Sell, 0 Flat} from barriers close[t]+/-k*atr[t],\n    resolved against bars t+1..t+horizon. Returns (labels, bars_to_hit,\n    same_bar_ambiguous) each of length len(close)-horizon.\"\"\"\n    n = len(close)\n    usable = n - horizon\n    if usable <= 0:\n        raise ValueError(f\"need more than {horizon} bars, got {n}\")\n\n    upper = close[:usable] + k * atr[:usable]\n    lower = close[:usable] - k * atr[:usable]\n\n    fwd_high = sliding_window_view(high, horizon)[1 : usable + 1]\n    "}
