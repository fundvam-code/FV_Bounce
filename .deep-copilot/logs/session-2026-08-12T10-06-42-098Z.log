= np.abs(o - prev_close)\n    return gap > sigma_mult * np.maximum(atr, 1e-12)\n\n\ndef find_time_gaps(timestamps: np.ndarray) -> np.ndarray:\n    gap = np.zeros(len(timestamps), dtype=bool)\n    gap[1:]"}
[2026-08-12T10:55:27.091Z] [TOOL_RESULT] {"id":"call_03_jPTBYXaG4BCEoXcaYATS1701","name":"read_file","elapsed_ms":64,"ok":true,"output":"r\"\"\"analyze_optimization.py — читает optimization_results.csv, который\nTrendRNN_EA.mq5 сам пишет в Common/Files/ из OnTesterDeinit() сразу после\nзавершения генетической оптимизации в Strategy Tester (собирает все\nFrameAdd-фреймы со всех проходов), и строит графики для выбора\nриск-параметров: PF/просадка/число сделок и чувствительность\nпо каждому оптимизируемому параметру.\n\nИспользование:\n  python src/analyze_optimization.py --csv path\\to\\optimization_results.csv\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport sys\nfrom pathlib import Path\n\nimport matplotlib\n\nmatplotlib.use(\"Agg\")\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\nMIN_TRADES = 30\nPARAM_COLUMNS = [\"confidence\", \"atr_sl_mult\", \"atr_tp_mult\", \"atr_trail_mult\"]\nSEQUENTIAL_CMAP = \"viridis\"\n\n\ndef load_results(csv_path: Path) -> pd.DataFrame:\n    df = pd.read_csv(csv_path)\n    df[\"reliable\"] = df[\"trades\"] >= MIN_TRADES\n    return df\n\n\ndef print_top(df: pd.DataFrame, n: int = 15) -> None:\n    reliable = df[df[\"reliable\"]].sort_values(\"score\", ascending=False)\n    print(f\"Прогонов всего: {len(df)}, с trades>={MIN_TRADES}: {len(reliable)}\\n\")\n    if reliable.empty:\n        print(\"Нет прогонов с достаточным числом сделок -- расширьте диапазон оптимизации.\")\n        return\n    print(f\"Топ-{min(n, len(reliable))} по score (Profit Factor со штрафом за просадку):\")\n    cols = [\"pass\", *PARAM_COLUMNS, \"profit_factor\", \"max_dd_percent\", \"trades\", \"win_rate\", \"score\"]\n    with pd.option_context(\"display.width\", 160, \"display.float_format\", \"{:.3f}\".format):\n        print(reliable[cols].head(n).to_string(index=False))\n\n\ndef plot_overview(df: pd.DataFrame, out_path: Path) -> None:\n    reliable = df[df[\"reliable\"]]\n    unreliable = df[~df[\"reliable\"]]\n\n    fig, axes = plt.subplots(1, 2, figsize=(13, 5.5))\n    fig.suptitle(\"Strategy Tester: обзор проходов оптимизации\", fontsize=13)\n\n    ax = axes[0]\n    if not unreliable.empty:\n        ax.scatter(unreliable[\"max_dd_percent\"], unreliable"}
